# Copy to cosmetic-agent/.env and replace every required placeholder locally.
# Never commit the resulting .env file.

# External model provider used by Terra-backed agents.
OPENAI_API_KEY=
TERRA_MODEL=gpt-5.6-terra
TERRA_TIMEOUT_SECONDS=20
TERRA_MAX_RETRIES=0
PRODUCT_WEB_SEARCH_MODEL=gpt-5.5
# Intent, guard, pain/gain, experience and composer use TERRA_MODEL via Responses.
# Legacy OPENAI_INTENT_MODEL / RESPONSE_COMPOSER_MODEL are no longer selected.
# Automatic titles use the existing deterministic prefix without model calls.
CONVERSATION_TITLE_LLM=0
# Optional isolated frontend build; only .next or a single .next-safe-name.
NEXT_DIST_DIR=.next

# MI300X APIs arrive through SSH forwards on Mac loopback only.
# TAIDE is an optional legacy service; it is not required by Terra chat.
ENABLE_TAIDE=0
TAIDE_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
RERANKER_BASE_URL=http://127.0.0.1:8006/v1
PHOTO_MODEL_BASE_URL=http://127.0.0.1:8025
TAIDE_HEALTH_URL=http://127.0.0.1:8000/healthz
TAIDE_ROUTER_HEALTH_URL=http://127.0.0.1:8001/healthz
EMBEDDING_HEALTH_URL=http://127.0.0.1:8002/healthz
ENABLE_RERANKER=0
ENABLE_PHOTO_MODEL=0

# Mac-owned data services. Use real credentials only in .env.
DATABASE_URL=
REDIS_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
ZEP_API_KEY=

# Production should require shared Redis-backed limits and job/admission state.
CHAT_LIMIT_REQUIRE_REDIS=1
CHAT_ADMISSION_REQUIRE_REDIS=1
CHAT_JOB_STORE_REQUIRE_REDIS=1
CHAT_STATE_REQUIRE_REDIS=1
CHAT_STATE_TTL_SECONDS=1800
KNOWLEDGE_QUERY_ADMISSION_REQUIRE_REDIS=1

# Generate independent high-entropy values for every secret below.
CHAT_GUEST_SESSION_SECRET=
CHAT_SECURITY_LOG_HMAC_SECRET=
PASSWORD_RESET_SECRET=
EMAIL_REGISTRATION_SECRET=
OAUTH_ONBOARDING_SECRET=

# Local Mac origins. Change these when a TLS reverse proxy is introduced.
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SESSION_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_COOKIE_SECURE=0
PUBLIC_FRONTEND_ORIGIN=http://127.0.0.1:3000
LOCAL_FRONTEND_ORIGIN=http://127.0.0.1:3000
PUBLIC_API_ORIGIN=http://127.0.0.1:8010

# Feature flags. GraphRAG remains incomplete until Neo4j and remote embedding pass.
KNOWLEDGE_GRAPH_ENABLED=1
KNOWLEDGE_QUERY_PIPELINE_ENABLED=1
AUTH_STORAGE_BACKEND=postgres
BLINKAI_IDENTITY_READ_STORE=postgres
