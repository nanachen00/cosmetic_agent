+        ("內包粉次怎麼辦", '{"terms":["閉鎖性粉刺","白頭粉刺"],"intent":"concern"}'),
+        ("水揚酸可以改善粉刺嗎", '{"terms":["水楊酸"],"intent":"ingredient"}'),
+    ],
