+    def _interpret_query(self, query: str) -> list[str]:
+        """Translate free-form wording into graph candidates without trusting LLM facts."""
+        if self.query_interpreter is None:
+            return []
+        try:
+            response = self.query_interpreter.complete(
+                model=self.query_interpreter_model,
+                messages=[
+                    {"role": "system", "content": _QUERY_INTERPRETER_SYSTEM_PROMPT},
+                    {
+                        "role": "user",
+                        "content": (
+                            "使用者輸入：" + query + "\n"
+                            "請整理最可能的圖譜實體候選詞。"
+                        ),
+                    },
+                ],
+                temperature=0.0,
+                max_tokens=180,
+            )
+        except Exception:
+            logger.warning("knowledge query interpretation failed", exc_info=True)
+            return []
+        text = str(response or "").strip()
+        start = text.find("{")
+        end = text.rfind("}")
+        if start < 0 or end <= start:
+            return []
+        try:
+            payload = json.loads(text[start : end + 1])
+        except (TypeError, ValueError, json.JSONDecodeError):
+            return []
+        terms = payload.get("terms") if isinstance(payload, dict) else None
+        if not isinstance(terms, list):
+            return []
+        result: list[str] = []
+        seen: set[str] = set()
+        for value in terms:
+            if not isinstance(value, str):
+                continue
+            term = " ".join(value.split())[:40]
+            key = normalize_lookup(term)
+            if not key or key in seen:
+                continue
+            seen.add(key)
+            result.append(term)
+            if len(result) >= 4:
+                break
+        return result
+
